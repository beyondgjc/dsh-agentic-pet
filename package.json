{
  "name": "dsh-agentic-pet",
  "description": "The pet-surface bundle: serves the desktop pet renderer over the web composition, turning dsh into a surface the desktop pet attaches to as an authenticated client",
  "version": "0.4.8",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/pet-settings.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./tools": "./lib/tools.js",
    "./presets/*.patch.yml": "./presets/*.patch.yml"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "client/**/*",
    "lib/types/**/*.d.ts",
    "carrier/**/*",
    "!carrier/assets/**",
    "presets/**/*"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/pet.patch.yml",
        "./presets/pet-inner-voice.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "immediately": true
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "dsh-agentic-pet-assets": "^0.1.0",
    "electron": "^44.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beyondgjc/dsh-agentic-pet.git"
  },
  "bugs": {
    "url": "https://github.com/beyondgjc/dsh-agentic-pet/issues"
  },
  "homepage": "https://github.com/beyondgjc/dsh-agentic-pet#readme"
}

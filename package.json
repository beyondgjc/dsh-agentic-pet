{
  "name": "dsh-agentic-pet",
  "description": "The pet-surface bundle: serves the desktop pet renderer over the web composition, turning dsh into a surface the desktop pet attaches to as an authenticated client",
  "version": "0.4.15",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/pet-settings.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./tools": "./lib/tools.js",
    "./persona": "./lib/persona.js",
    "./presets/*.patch.yml": "./presets/*.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "client/**/*",
    "lib/types/**/*.d.ts",
    "carrier/**/*",
    "!carrier/assets/**",
    "presets/**/*",
    "locale/*.json",
    "docs/DETAIL.zh.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/pet.patch.yml",
        "./presets/pet-inner-voice.patch.yml",
        "./presets/pet-custom.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "immediately": true
    },
    "manifestVersion": 1
  },
  "dependencies": {
    "dsh-agentic-pet-assets": "^0.1.2",
    "electron": "44.10.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/dsh-typert-protocol": "link:..\\dsh\\deepseek-harness\\packages\\typert\\protocol",
    "@jridgewell/gen-mapping": "^0.3.13",
    "@types/node": "^24.19.2",
    "js-yaml": "^4.3.2",
    "tsdown": "^0.22.2",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beyondgjc/dsh-agentic-pet.git"
  },
  "bugs": {
    "url": "https://github.com/beyondgjc/dsh-agentic-pet/issues"
  },
  "homepage": "https://github.com/beyondgjc/dsh-agentic-pet#readme"
}
